# See https://github.com/github/gitignore for stack-specific starting points.

# env
.env
.env.prod
.env.*
!.env.example
.env*.local

# misc
.DS_Store
*.pem
*.log

# editor
.vscode/*
!.vscode/extensions.json
.idea
*:Zone.Identifier

# dependencies and package-manager state
node_modules/
.pnpm-store/

# TypeScript and build output
*.tsbuildinfo
dist/
coverage/
.turbo/
.next/
out/

# generated database client and local database files
Apti-App/packages/database/src/generated/
*.db
*.db-journal

# test output
playwright-report/
test-results/
