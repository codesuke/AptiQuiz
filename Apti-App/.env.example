# Browser-visible URL of the long-running Socket.IO server.
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Game server configuration.
GAME_SERVER_PORT=3001
GAME_SERVER_ORIGIN=http://localhost:3000
# Required: at least 32 characters. Generate one with `openssl rand -base64 32`.
GAME_SERVER_SECRET=replace-with-at-least-32-random-bytes
LOG_LEVEL=info

# Durable data. Replace with a hosted PostgreSQL URL outside local development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aptiquiz?schema=public

# Better Auth and account configuration.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
# Optional Google sign-in. Leave both empty to hide the Google button.
# Authorized redirect URI for local development: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
# Reserved for transactional email. Use a dedicated Gmail/Google Workspace sender address.
# Create a 16-character Google App Password after enabling 2-Step Verification:
# https://myaccount.google.com/apppasswords
# Never use your normal Google account password or commit these values.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: Game Server URL the web server uses for internal Room registration.
# Set it when the web server reaches the Game Server on a private network address.
# Defaults to NEXT_PUBLIC_GAME_SERVER_URL.
GAME_SERVER_INTERNAL_URL=
