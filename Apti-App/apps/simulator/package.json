    "simulate:bots": "tsx src/bots.ts"
  },
  "dependencies": {
    "@aptiquiz/contracts": "workspace:*",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@aptiquiz/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
