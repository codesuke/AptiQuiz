{
  "name": "@aptiquiz/game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aptiquiz/contracts": "workspace:*",
    "@aptiquiz/database": "workspace:*",
    "@aptiquiz/game-engine": "workspace:*",
    "@aptiquiz/socket-ticket": "workspace:*",
    "pino": "^10.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@aptiquiz/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "jose": "^6.2.12",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
