generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum RoomStatus {
  LOBBY
  RUNNING
  FINISHED
  CANCELLED
}

enum RoundStatus {
  PENDING
  OPEN
  REVEALED
  CLOSED
}

model College {
  id             String        @id @default(cuid())
  name           String
  normalizedName String        @unique
  createdAt      DateTime      @default(now())
  rooms          Room[]
  participants   Participant[]
  matchResults   MatchResult[]
  homeUsers      User[]
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  suspended     Boolean       @default(false)
  homeCollegeId String?
  homeCollege   College?      @relation(fields: [homeCollegeId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      Account[]
  sessions      Session[]
  questionSets  QuestionSet[]
  hostedRooms   Room[]
  participants  Participant[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model QuestionSet {
  id             String     @id @default(cuid())
  ownerId        String?
  idempotencyKey String?
  isStarter      Boolean    @default(false)
  title          String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  owner          User?      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  questions      Question[]
  rooms          Room[]

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId])
}

model Question {
  id              String      @id @default(cuid())
  questionSetId   String
  idempotencyKey  String?
  position        Int
  text            String
  options         Json
  correctOptionId String
  explanation     String?
  topic           String
  difficulty      Difficulty
  media           Json?
  questionSet     QuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  rounds          Round[]

  @@unique([questionSetId, position])
  @@unique([questionSetId, idempotencyKey])
  @@index([questionSetId])
}

model Room {
  id               String        @id @default(cuid())
  joinCode         String        @unique
  hostId           String
  collegeId        String
  questionSetId    String
  // Stable copy of the Question Set's Questions at Room creation; later edits do not change it.
  questionSnapshot Json
  idempotencyKey   String?
  status           RoomStatus    @default(LOBBY)
  createdAt        DateTime      @default(now())
  completedAt      DateTime?
  host             User          @relation(fields: [hostId], references: [id])
  college          College       @relation(fields: [collegeId], references: [id])
  questionSet      QuestionSet   @relation(fields: [questionSetId], references: [id])
  participants     Participant[]
  rounds           Round[]
  matchResults     MatchResult[]

  @@unique([hostId, idempotencyKey])
  @@index([hostId])
  @@index([collegeId, createdAt])
  @@index([questionSetId])
}

model Participant {
  id              String        @id @default(cuid())
  roomId          String
  collegeId       String
  userId          String?
  idempotencyKey  String
  displayName     String
  // Resume Tokens arrive with reconnect support (PRD #6); until then a Participant has none.
  resumeTokenHash String?       @unique
  score           Int           @default(0)
  joinedAt        DateTime      @default(now())
  room            Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  college         College       @relation(fields: [collegeId], references: [id])
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers         Answer[]
  matchResults    MatchResult[]

  @@unique([roomId, idempotencyKey])
  @@unique([roomId, userId])
  @@index([roomId])
  @@index([collegeId, score])
}

model Round {
  id         String      @id @default(cuid())
  roomId     String
  questionId String
  position   Int
  startsAt   DateTime?
  endsAt     DateTime?
  status     RoundStatus @default(PENDING)
  room       Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id])
  answers    Answer[]

  @@unique([roomId, position])
  @@index([questionId])
}

model Answer {
  id                 String      @id @default(cuid())
  roundId            String
  participantId      String
  selectedOptionId   String
  receivedAt         DateTime
  effectiveElapsedMs Int
  correct            Boolean
  points             Int
  round              Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participant        Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([roundId, participantId])
  @@index([participantId])
}

model MatchResult {
  id                String      @id @default(cuid())
  roomId            String
  participantId     String
  collegeId         String
  totalScore        Int
  correctAnswers    Int
  totalAnswers      Int
  averageResponseMs Int
  topicStats        Json
  completedAt       DateTime    @default(now())
  room              Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participant       Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  college           College     @relation(fields: [collegeId], references: [id])

  @@unique([roomId, participantId])
  @@index([collegeId, completedAt])
  @@index([totalScore])
}
