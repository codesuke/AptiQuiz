{
  "name": "@aptiquiz/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:studio": "prisma studio --config prisma7.config.ts",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@aptiquiz/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "prisma": "^7.8.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
